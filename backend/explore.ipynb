   "source": [
    "conn = sqlite3.connect(\"cache.db\")\n",
    "cur = conn.cursor()\n",
    "cur.execute(\"SELECT COUNT(*) FROM generation_logs;\")\n",
    "rows = cur.fetchall()\n",
    "conn.close()\n",
    "for row in rows:\n",
    "   print(row)"
